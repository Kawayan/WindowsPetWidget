<Window x:Class="WindowsPetWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowsPetWidget"
        Width="192"
        Height="208"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        LostMouseCapture="Window_LostMouseCapture">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopmostMenuItem"
                      Header="常に手前に表示"
                      IsCheckable="True"
                      IsChecked="True"
                      Click="TopmostMenuItem_Click" />
            <MenuItem Header="サイズ">
                <MenuItem x:Name="LargeSizeMenuItem"
                          Header="大"
                          Tag="Large"
                          IsCheckable="True"
                          Click="SizeMenuItem_Click" />
                <MenuItem x:Name="MediumSizeMenuItem"
                          Header="中"
                          Tag="Medium"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="SizeMenuItem_Click" />
                <MenuItem x:Name="SmallSizeMenuItem"
                          Header="小"
                          Tag="Small"
                          IsCheckable="True"
                          Click="SizeMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="位置をリセット"
                      Click="ResetPositionMenuItem_Click" />
            <Separator />
            <MenuItem Header="終了"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Width="192"
               Height="208"
               Stretch="Fill"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
    </Grid>
</Window>
